# ==============================================================================
# HealthBot AI - Production Environment Variables Configuration (.env)
# ==============================================================================

# [REQUIRED] Groq API Key for LLM RAG inference (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# [REQUIRED for Admin] Secret token required to access Admin Dashboard and API (/admin, /api/admin/*)
ADMIN_TOKEN=your_secure_admin_token_here

# [OPTIONAL] Groq model name for grounded answers
# Options: openai/gpt-oss-120b (default), openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# [OPTIONAL] Cosine distance relevance threshold for out-of-scope fallback (default: 50.014)
RELEVANCE_THRESHOLD=50.014

# [OPTIONAL] Rate limit per IP per minute for /api/ask (default: 15)
RATE_LIMIT_PER_MIN=15

# [OPTIONAL] Persistent storage directory for ChromaDB vector database
# Default: ./chroma_db (For persistent disks on cloud hosts, set e.g. /var/data/chroma_db)
CHROMA_DIR=./chroma_db

# [OPTIONAL] Persistent storage path for SQLite query audit log
# Default: ./query_log.db (For persistent disks on cloud hosts, set e.g. /var/data/query_log.db)
LOG_DB=./query_log.db

# [OPTIONAL] CORS allowed origins (comma-separated, default: * for public access)
CORS_ORIGINS=*
